### 15. Delete Single Evaluation Record by ID
DELETE {{baseUrl}}/api/evaluations/{{evalId}}

# Response:
# {
#   "status": "deleted",
#   "evaluation_id": "8e96e628-e43d-45e3-a95e-b266e1fa5503"
# }

### 16. Clear All Evaluation Logs for Tenant
DELETE {{baseUrl}}/api/evaluations?tenant_id={{tenantId}}

# Response:
# {
#   "status": "cleared",
#   "deleted_count": 12,
#   "tenant_id": "S-NET"
# }
