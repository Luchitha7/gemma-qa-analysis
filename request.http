### 6. Get Stored Policy Knowledge Chunks (Vector RAG)
GET {{baseUrl}}/api/tenants/{{tenantId}}/policies

# Response:
# [
#   {
#     "title": "S-NET Communications - Hold & Silence Management SLA",
#     "content": "S-NET Communications Policy: Hold times must NOT exceed 3 minutes. Dead air max 20 seconds. 5 seconds grace period allowed."
#   },
#   {
#     "title": "S-NET Communications - Customer Verification & Identification Standard",
#     "content": "S-NET Communications Standard: All 4 details must be validated: Caller full name, Company name, Email address, Callback number."
#   }
# ]

### 7. List Uploaded Documents for Tenant
GET {{baseUrl}}/api/tenants/{{tenantId}}/documents

# Response:
# [
#   {
#     "id": 1,
#     "filename": "snet_qa_guideline.pdf",
#     "page_count": 8,
#     "uploaded_at": "2026-08-18T10:05:00"
#   }
# ]

### 8. Delete a Single Guideline Document by ID
DELETE {{baseUrl}}/api/tenants/{{tenantId}}/documents/1

# Response:
# {
#   "status": "deleted",
#   "document_id": 1,
#   "filename": "snet_qa_guideline.pdf"
# }

### 9. Clear All Tenant Knowledge Base (Documents, Criteria & Vector Chunks)
DELETE {{baseUrl}}/api/tenants/{{tenantId}}/knowledge-base

# Response:
# {
#   "status": "cleared",
#   "tenant_id": "S-NET",
#   "message": "All documents, criteria, and vector policies cleared."
# }

