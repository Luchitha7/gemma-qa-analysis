
# Host and port for the FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=info


# Base endpoint for Ollama generate API
OLLAMA_URL=http://localhost:11434/api/generate
# Endpoint for fetching installed models
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
# LLM model tag in Ollama
GEMMA_MODEL=gemma3:1b
# Request timeout in seconds
GEMMA_TIMEOUT=180
# Sampling temperature (0.0 for deterministic evaluation)
GEMMA_TEMPERATURE=0.0
# Maximum output generation tokens per call
GEMMA_NUM_PREDICT=320


# HuggingFace model repo for sentiment classification
ROBERTA_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# Embedding model used for knowledge base retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2


# Path to the JSON file storing runtime weight overrides
WEIGHTS_FILE_PATH=weights.json
