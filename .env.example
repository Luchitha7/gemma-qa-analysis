# 1. PostgreSQL Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qa_database

# Optional direct connection URL override
# DATABASE_URL=postgresql://username:password@localhost:5432/qa_database

# 2. Local LLM Configuration (Ollama)
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma3:4b # or your model

# 3. Vector Embeddings & Storage (ChromaDB / MiniLM)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=vector_data

# 5. Application Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 6. Prompts Configuration
PROMPT_SUMMARY_PATH=resources/prompts/summary_prompt.txt
PROMPT_SUGGESTIONS_PATH=resources/prompts/suggestions_prompt.txt
PROMPT_SCORECARD_PATH=resources/prompts/scorecard_prompt.txt
PROMPT_DYNAMIC_EVALUATION_PATH=resources/prompts/dynamic_evaluation_prompt.txt
