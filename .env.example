
# 1. PostgreSQL Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qa_database

# Optional direct connection URL override
# DATABASE_URL=postgresql://username:password@localhost:5432/qa_database

# 2. Local LLM Configuration (Ollama)
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma3:4b # or your model

# 3. Vector Embeddings & Storage (ChromaDB / MiniLM)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=vector_data

# 4. Sentiment Intensity Model (RoBERTa)
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_CONFIDENCE_THRESHOLD=0.6
SENTIMENT_INTENSITY_THRESHOLD=-0.7

# 5. Application Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
