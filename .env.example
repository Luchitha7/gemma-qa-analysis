# Copy this file to `.env` and adjust values for your environment.
# `.env` is gitignored; this template is committed. Defaults below match the
# hardcoded values the code used before config was externalized, so copying
# this file verbatim reproduces the previous behavior.

# ---- Web server (FastAPI / uvicorn) ----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=info
# Full base URL the load test (tests/locustfile.py) targets.
# APP_URL=http://localhost:8000

# ---- Gemma via Ollama ----
# Base endpoint for the Ollama generate API
OLLAMA_URL=http://localhost:11434/api/generate
# Endpoint for listing installed models (used by tests/compare_models.py)
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
# LLM model tag in Ollama
GEMMA_MODEL=gemma3:1b
# Request timeout in seconds
GEMMA_TIMEOUT=180
# Sampling temperature (0.0 = deterministic, best for evaluation)
GEMMA_TEMPERATURE=0.0
# Max output tokens Gemma may generate per call
GEMMA_NUM_PREDICT=320

# ---- Models (HuggingFace) ----
# RoBERTa sentiment/intensity model
ROBERTA_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# Embedding model used by the RAG steps
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Runtime state ----
# Path to the JSON file storing weight overrides saved from the frontend.
# Leave unset to keep the default (weights.json next to weights_config.py).
# WEIGHTS_FILE_PATH=weights.json

# ---- Batch test harness (tests/run_batch_test.py) ----
# Path to the .docx of test transcripts the batch runner reads.
# BATCH_DOCX_PATH=/absolute/path/to/SignalQA_Test_Transcripts.docx
