
# Host and port for the FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=info


# Base endpoint for Ollama generate API
OLLAMA_URL=http://localhost:11434/api/generate
# Endpoint for fetching installed models
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
# LLM model tag in Ollama
GEMMA_MODEL=gemma3:1b
# Request timeout in seconds
GEMMA_TIMEOUT=180
# Sampling temperature (0.0 for deterministic evaluation)
GEMMA_TEMPERATURE=0.0
# Maximum output generation tokens per call
GEMMA_NUM_PREDICT=320

# --- RoBERTa Sentiment Model Settings ---
# HuggingFace model repo for sentiment classification
ROBERTA_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# Minimum prediction confidence score before defaulting to neutral (0.0)
SENTIMENT_CONFIDENCE_THRESHOLD=0.6
# Sentiment score cutoff for flagging intense/heated moments (-1.0 to 1.0)
SENTIMENT_INTENSITY_THRESHOLD=-0.7

# --- Sentence-Transformers Embedding (RAG) Settings ---
# Embedding model used for knowledge base retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Cosine similarity threshold for strong KB matches
RAG_STRONG_MATCH_THRESHOLD=0.55
# Cosine similarity threshold for weak KB matches
RAG_WEAK_MATCH_THRESHOLD=0.35
# Minimum similarity required to evaluate question accuracy
RAG_ACCURACY_RETRIEVAL_THRESHOLD=0.35
# Minimum similarity required to mark a key point as covered
RAG_ACCURACY_KEY_POINT_THRESHOLD=0.35
# Minimum similarity to flag an agent line as a compliance violation
RAG_COMPLIANCE_VIOLATION_THRESHOLD=0.45

# --- Response Time Analytics (Seconds) ---
# Maximum delay for full score (1.0)
RESPONSE_TIME_GOOD_SECONDS=5
# Threshold at or above which a response is marked slow
RESPONSE_TIME_SLOW_SECONDS=12
# Delay at or above which score decays to zero (0.0)
RESPONSE_TIME_MAX_SECONDS=25

# --- Job Queue & Concurrency Controls ---
# Number of concurrent worker threads scoring calls simultaneously
QA_MAX_CONCURRENT=2
# Total queue capacity (active + waiting) before returning HTTP 503
QA_CAPACITY=5
# Retry-After header duration (seconds) sent with 503 responses
QA_RETRY_AFTER=10

# --- Default Scoring Weights (Must sum to 1.0) ---
WEIGHT_AGENT=0.45
WEIGHT_ACCURACY=0.20
WEIGHT_COMPLIANCE=0.20
WEIGHT_CONVERSATION=0.10
WEIGHT_RESPONSE_TIME=0.05

# --- Rating Score Values ---
RATING_SCORE_PASS=100
RATING_SCORE_PARTIAL=50
RATING_SCORE_FAIL=0

# --- Storage & Persistence ---
# Path to the JSON file storing runtime weight overrides
WEIGHTS_FILE_PATH=weights.json

# --- HuggingFace & Transformers Optimizations ---
TRANSFORMERS_VERBOSITY=error
HF_HUB_DISABLE_PROGRESS_BARS=1
